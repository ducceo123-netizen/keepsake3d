# Local demo defaults. Render uses explicit values in render.yaml instead.
KEEPSAKE_DEPLOYMENT_MODE=local-demo
KEEPSAKE_DATA_DIR=.data/private
KEEPSAKE_STORAGE_MODE=local
KEEPSAKE_RETENTION_HOURS=24
KEEPSAKE_ALLOWED_ORIGIN=http://localhost:3000

# Single-service static export (optional locally; Render: /app/public).
# Generate with KEEPSAKE_STATIC_EXPORT=1 npm run build, then use apps/web/out.
KEEPSAKE_WEB_DIR=

# Exact additional host names, comma-separated; no wildcards.
# Render hostname and the allowed origin's hostname are included automatically.
KEEPSAKE_ALLOWED_HOSTS=
# API docs default on locally and off in public-demo; omit to use that default.
# KEEPSAKE_ENABLE_DOCS=0

# One API process/instance is required by the SQLite/local queue implementation.
# Public Render free demo: /tmp/keepsake-data, storage mode ephemeral. Files can
# disappear at restart/redeploy before their retention deadline.
KEEPSAKE_BUILD_WORKERS=1
KEEPSAKE_MAX_PENDING_BUILDS=2
KEEPSAKE_BUILD_TIMEOUT_SECONDS=600
# Public defaults below are bounded resource caps, not an SLA.
KEEPSAKE_MAX_STORAGE_MB=512
KEEPSAKE_MAX_SESSIONS=100
KEEPSAKE_MAX_BUILDS_PER_HOUR=30
KEEPSAKE_MAX_IMAGE_PIXELS=8000000

# Actual Blender executable. Empty finds PATH/the local portable installation.
BLENDER_BIN=
BLENDER_TIMEOUT_SECONDS=540
BLENDER_THREADS=2
# Render free settings are 512px, 8 samples, no denoise, 1 thread, 900s timeout;
# API parent timeout must be larger (Render sets 1000s).

# Optional separate operator credential. Empty disables admin access.
# Public mode requires at least 32 random characters. Never commit a real value.
KEEPSAKE_OPERATOR_TOKEN=
