{
  "$defs": {
    "Character": {
      "additionalProperties": false,
      "properties": {
        "hair_style_asset_id": {
          "default": "short",
          "enum": [
            "short",
            "long",
            "bun",
            "bob",
            "curly_short",
            "curly_long",
            "buzz",
            "bald"
          ],
          "title": "Hair Style Asset Id",
          "type": "string"
        },
        "hair_color_id": {
          "default": "chestnut",
          "enum": [
            "chestnut",
            "black",
            "blonde",
            "silver",
            "auburn",
            "brown"
          ],
          "title": "Hair Color Id",
          "type": "string"
        },
        "facial_hair_id": {
          "default": "none",
          "enum": [
            "none",
            "stubble",
            "moustache",
            "beard"
          ],
          "title": "Facial Hair Id",
          "type": "string"
        },
        "glasses_asset_id": {
          "default": "none",
          "enum": [
            "none",
            "round",
            "rectangular"
          ],
          "title": "Glasses Asset Id",
          "type": "string"
        },
        "skin_material_id": {
          "default": "warm",
          "enum": [
            "light",
            "warm",
            "tan",
            "deep"
          ],
          "title": "Skin Material Id",
          "type": "string"
        },
        "outfit_palette_id": {
          "default": "cream",
          "enum": [
            "cream",
            "blue",
            "rose",
            "sage",
            "black",
            "white",
            "gray",
            "red",
            "brown",
            "navy",
            "yellow",
            "purple"
          ],
          "title": "Outfit Palette Id",
          "type": "string"
        },
        "pants_palette_id": {
          "default": "blue",
          "enum": [
            "cream",
            "blue",
            "rose",
            "sage",
            "black",
            "white",
            "gray",
            "red",
            "brown",
            "navy",
            "yellow",
            "purple"
          ],
          "title": "Pants Palette Id",
          "type": "string"
        },
        "shoes_palette_id": {
          "default": "white",
          "enum": [
            "cream",
            "blue",
            "rose",
            "sage",
            "black",
            "white",
            "gray",
            "red",
            "brown",
            "navy",
            "yellow",
            "purple"
          ],
          "title": "Shoes Palette Id",
          "type": "string"
        },
        "face_morphs": {
          "$ref": "#/$defs/FaceMorphs"
        },
        "engraving_text": {
          "default": "",
          "maxLength": 12,
          "pattern": "^[A-Za-z -]*$",
          "title": "Engraving Text",
          "type": "string"
        }
      },
      "title": "Character",
      "type": "object"
    },
    "Characters": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/Character"
        },
        "right": {
          "$ref": "#/$defs/Character"
        }
      },
      "title": "Characters",
      "type": "object"
    },
    "FaceMorphs": {
      "additionalProperties": false,
      "properties": {
        "face_width": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Face Width",
          "type": "number"
        },
        "face_height": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Face Height",
          "type": "number"
        },
        "jaw_width": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Jaw Width",
          "type": "number"
        },
        "chin_length": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Chin Length",
          "type": "number"
        },
        "cheek_fullness": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Cheek Fullness",
          "type": "number"
        },
        "eye_spacing": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Eye Spacing",
          "type": "number"
        },
        "eye_size": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Eye Size",
          "type": "number"
        },
        "brow_thickness": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Brow Thickness",
          "type": "number"
        },
        "brow_arch": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Brow Arch",
          "type": "number"
        },
        "nose_width": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Nose Width",
          "type": "number"
        },
        "nose_projection": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Nose Projection",
          "type": "number"
        },
        "mouth_width": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Mouth Width",
          "type": "number"
        },
        "smile": {
          "default": 0.0,
          "maximum": 1,
          "minimum": -1,
          "title": "Smile",
          "type": "number"
        }
      },
      "title": "FaceMorphs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "characters": {
      "$ref": "#/$defs/Characters"
    }
  },
  "title": "Parameters",
  "type": "object"
}
